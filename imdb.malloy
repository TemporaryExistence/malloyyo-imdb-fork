##! experimental.virtual_source experimental.persistence experimental.join_types experimental.givens

// storage sources — swap between "gs.malloy" (GCS parquet) and "md.malloy"
// (MotherDuck, faster). Both define the same source names.
import "md.malloy"

given:
  # label="Name" suggest{query=name_options dimension=name}
  NAME :: filter<string> is f'Tom Hanks'

  # label="Movie Title"  suggest{source=movies dimension=primaryTitle}
  TITLE :: filter<string> is f''

  # label="Genre"  suggest{source=movies dimension=genre}
  GENRE :: filter<string> is f''

source: people is people_table extend {
  // cast, crew, everyone involved in movies
  primary_key: nconst
}

source: principals is principals_table extend {
  // a mapping table that links people to movies, along with their job on that movie.
  join_one: people is people on nconst = people.nconst
  measure: principal_count is count()
}

query: genre_movie_map is titles_table -> {
  group_by:
    tconst
    genre is genres.value
}

query: titles_per_year is titles_table -> {
  group_by:
    startYear
  aggregate: title_count is count(tconst)
}


#" IMDB dataset of the the most popular movies in the imdb (by total_votes)"
#|(agent) 
   People on a movie are exposed as two flattened pairs so you don't have to
   walk the principals -> people join:
     (name,  job)  - a person and the role they played on the movie
     (name2, job2) - a SECOND, independent person on the same title
   Group/filter on these directly. Combine the two pairs to relate two people
   on one movie - e.g. composers who worked with a given director.

   Genres follow the same flattened-pair pattern:
     genre  - a genre on the movie
     genre2 - a SECOND, independent genre on the same title
   Group/filter on these directly. Combine the two to relate two genres on one
   movie - e.g. how often comedy and romance appear together.

   Possible job / job2 values (most to least common):
     actor, actress, producer, writer, editor, composer, casting_director,
     director, cinematographer, production_designer, self, archive_footage,
     archive_sound
|#
source: movies is titles_table extend {
  // all the movies
  join_many: principals on tconst = principals.tconst
  join_many: principals2 is principals on tconst = principals2.tconst
  join_many: genre_movie_map on tconst = genre_movie_map.tconst
  join_many: director is people on directors.each = director.nconst
  primary_key: tconst

  measure:
    title_count is count(tconst)
    row_count is count()
    # format="#,###"
    total_ratings is sum(numVotes / 1000.0)
    average_rating is averageRating.avg()
    # percent
    percent_of_titles is title_count / all(title_count)

  dimension:
    # image {width="150px"}
    movie_image is concat('https://www.clearplay.com/MovieBattle/images/', tconst, '.jpg')
    # link
    movie_url is concat('https://www.imdb.com/title/', tconst)

    # drill {to=[title_detail]}
    title is primaryTitle

    # drill {to=[genre_pairs] given=GENRE}
    genre is genres.value
    # drill {to=[genre_pairs] given=GENRE}
    genre2 is genre_movie_map.genre
    job is principals.category
    job2 is principals2.category

    # drill {to=[works_together] given=NAME}
    name is principals.people.primaryName

    # drill {to=[works_together] given=NAME}
    name2 is principals2.people.primaryName



  #" Movies with poster, year and vote count
  view: by_title is {
    group_by:
      tconst, primaryTitle, startYear, numVotes
    order_by: numVotes desc
  }

  # bar_chart
  #" Genres by title count and average year
  view: genre_and_time is {
    group_by: genre is genre2
    aggregate: title_count
    aggregate: avg_year is startYear.avg()
  }

  # line_chart
  #" Titles released per year
  view: by_year is {
    group_by: startYear
    aggregate: title_count
    order_by: startYear desc
  }

  #" People (cast and crew) by ratings and number of titles
  view: by_name is {
    group_by: principals.people.primaryName, principals.nconst
    aggregate: total_ratings, title_count
  }

  #" Title counts by job category (actor, director, composer, …)
  view: by_job_category is {
    group_by: job
    aggregate: title_count
  }

  # list
  #" List of job categories with title counts
  view: job_list is by_job_category

  # list
  #" List of titles by total ratings
  view: title_list is {
    group_by: title
    aggregate: total_ratings
  }

  #" Find people that worked together, filter on name (e.g. where: name = 'Tom Hanks')
  view: works_with is {
    where: name != name2
    group_by: name2
    aggregate: title_count, percent_of_titles
    # list
    nest: by_job is {
      group_by: job is principals2.category
      aggregate: title_count
    }
    limit: 10
  }

  # artifact { title='People that worked together' }
  #" People that worked together, use given $NAME to filter
  view: works_together is works_with + {
    where: name ~ $NAME
    nest: by_title is {
      group_by: title
      aggregate: total_ratings
    }
  }

  view: name_suggest is {
    group_by: name
    aggregate: total_ratings
  }

  #" Genres by title count and ratings
  view: by_genre is {
    group_by: genre is genres.value
    aggregate: title_count, total_ratings, percent_of_titles
  }

  #" Top directors by total ratings
  view: top_directors is {
    limit: 100
    where: job = 'director'
    group_by: 
      name 
      principals.nconst
    aggregate: total_ratings
  }

 # dashboard {columns=6} artifact {title='Genre Combinations and Top Titles'}
  #" Genre combinations with top titles and percent of year's titles
 view: genre_pairs is {
    join_one: titles_per_year on startYear = titles_per_year.startYear
    where: genre != genre2
      and (genre < genre2 or not '' ~ $GENRE )
      and genre ~ $GENRE
    # colspan=3
    group_by: `Genre Combination` is concat(genre,'/', genre2)
    # hidden
    aggregate: total_ratings
    # colspan=3
    //# list
    nest: `Top Titles Overall` is {
      group_by: title, `Year` is startYear
      # hidden
      aggregate: total_ratings
      limit: 10
    }

    # colspan=3
    # line_chart{ y.independent}
    nest: `By Year as a Percent of Year's Titles (hover for detail)` is {
      group_by: 
        # label="Year"
        startYear
      aggregate:
        # percent
        `Percent of titles in Year` is title_count / max(titles_per_year.title_count)
      order_by: startYear
      # tooltip
      nest: titles is {
        group_by: title
        aggregate: total_ratings
        limit: 5
      }
    }
    limit: 100
  }


  # artifact{title="Movie Detail"}
  view: title_detail is {
    where: title ~ $TITLE
    group_by: 
      title
      startYear
      genres
    nest: `Cast` is {
      group_by: name, job
    }
    limit: 5
  }

  #" Top actors and actresses by total ratings
  view: top_actors is {
    limit: 100
    where: job = 'actor' | 'actress'
    group_by: name, principals.nconst
    aggregate: total_ratings
  }

  # dashboard
  #" Dashboard of top titles with nested genres and cast
  view: titles_dashboard is {
    group_by:
      movie_image
      production_year is startYear
      title, runtimeMinutes, movie_url
    nest:
      genre_list is by_genre
      by_cast is by_job_category + {
        # list
        nest: names is by_name + { limit: 200 }
      }
    limit: 20
    order_by: 2 desc
  }
}

// Name typeahead options for the NAME given — most popular first
// (name_suggest orders by total_ratings desc). `dimension=name` lets the
// runtime refine this server-side as the user types.
query: name_options is movies -> name_suggest

// example queries
// so the top people in the movie buisiness
run: movies -> by_name

// the people by the number of times they've been in the top 10
run: people -> {
  group_by: primaryName
  aggregate: top10_count is by_year.sum(pick 1 when by_year.year_rank <= 10 else 0)
}

run: movies -> by_name + {
  where: job = 'director'
  nest:
    by_genre + { limit: 5 order_by: total_ratings desc }
}

run: movies -> by_title + {
  join_one: d is movies -> top_actors + { limit: 500 } -> nconst inner on directors.each = d.nconst
  //where_exists: directors.each in movies->top_actors->nconst
  nest: director_list is { group_by: director is director.primaryName }
  limit: 100
  order_by: numVotes desc
}

run: movies -> top_actors -> nconst

run: movies -> genre + title_count + {
  limit: 100
}

run: principals -> category + principal_count

run: movies -> by_title + {
  join_one: d is movies -> top_directors + {
    limit: 50
  } -> nconst inner on directors.each = d.nconst
  nest: director_list is { group_by: director is director.primaryName }
  order_by: startYear desc
}

run: movies -> by_title + {
  where: director.primaryName = 'Steven Spielberg'
}

run: movies -> {
  where: directors.each = 'nm0000229'
  group_by:
    startYear
    genre is genres.value
  aggregate: title_count
  order_by: startYear
  limit: 10000
}

run: movies -> {
  where: director.primaryName = 'Steven Spielberg'
  group_by:
    startYear
    genre is genres.value
  aggregate: title_count
  order_by: startYear
  limit: 10000
}

run: movies -> {
  where: job = 'composer'
  group_by: director is director.primaryName
  aggregate:
    total_ratings, title_count
    actor_count is count(name)
    actors_per_film is count(name) / title_count
  nest:
    composer is {
      group_by: composer is name
      aggregate: title_count
      order_by: title_count desc
      # list
      nest: title
      limit: 10
    }
  order_by: total_ratings desc
  limit: 100
}
