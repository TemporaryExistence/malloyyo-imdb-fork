##! experimental.persistence  experimental.virtual_source

source: raw_titles is build.sql(""" 
		SELECT * FROM
		read_csv_auto(
			-- 'https://datasets.imdbws.com/title.basics.tsv.gz'
			'data/title.basics.tsv.gz'
			, all_varchar=true, delim='\t', quote='',header=True)
	""")

source: raw_principals is build.sql(""" 
		SELECT * FROM
		read_csv_auto(
			-- 'https://datasets.imdbws.com/title.principals.tsv.gz'
			'data/title.principals.tsv.gz'
			, all_varchar=true, delim='\t', quote='',header=True)
	""")

source: raw_ratings is build.sql(""" 
		SELECT * FROM
		read_csv_auto(
			-- 'https://datasets.imdbws.com/title.ratings.tsv.gz'
			'data/title.ratings.tsv.gz'
			, all_varchar=true, delim='\t', quote='',header=True)
	""")

source: raw_crew is build.sql(""" 
		SELECT * FROM
		read_csv_auto(
			-- 'https://datasets.imdbws.com/title.crew.tsv.gz'
			'data/title.crew.tsv.gz'
			, all_varchar=true, delim='\t', quote='',header=True)
	""")
source: raw_names is build.sql(""" 
		SELECT * FROM
		read_csv_auto(
			-- 'https://datasets.imdbws.com/name.basics.tsv.gz'
			'data/name.basics.tsv.gz'
			, all_varchar=true, delim='\t', quote='',header=True)
	""")

type: title_type is {
	tconst:: string,
	isAdult:: string,
	originalTitle:: string,
	primaryTitle:: string,
	startYear:: number,
	endYear:: number,
	runtimeMinutes:: number,
	genres:: string[],
	directors:: string[],
	writers:: string[],
	averageRating:: number,
	numVotes:: number,	
	overall_rank:: number,
	year_rank:: number
}

#@ persist name="titles"
source: titles_base is raw_titles -> {
	join_one: raw_ratings on tconst = raw_ratings.tconst
	join_one: raw_crew on tconst = raw_crew.tconst
	// Films only, exactly as upstream. A fork change briefly added tvSeries /
	// tvMiniSeries / tvMovie here (2026-08-04) and it was REVERSED on 2026-08-05
	// after Andrew met Lloyd: he does not want the data sets intermingled, and
	// the corpus is his call on his tool. See CHARTER.md §7.2.
	// Do not re-add television to this line without a charter amendment.
	where:
		raw_ratings.numVotes::number > 5000
		and titleType = 'movie'
	select:
		tconst
		// `titleType` was carried while the corpus held television (to label
		// series vs film and pick the TMDB endpoint). With the corpus back to
		// films only it is a constant column, so it is dropped here rather than
		// left as dead width -- upstream never had it. CHARTER.md §7.2.
		isAdult, originalTitle, primaryTitle
		startYear is startYear:::number 
		endYear is endYear:::number
		runtimeMinutes is runtimeMinutes:::number
		genres is str_split!string[](genres,',')
		directors is str_split!string[](raw_crew.directors,',')
		writers is str_split!string[](raw_crew.writers,',')
		averageRating is raw_ratings.averageRating:::number
		numVotes is raw_ratings.numVotes:::number
	calculate:
		overall_rank is rank() {order_by: averageRating desc}
		year_rank is rank() {partition_by: startYear order_by: averageRating desc}
}::title_type extend {
	view: test is {
		select: *
		limit: 10
	}
}

type: principal_type is {
	tconst:: string,
	ordering:: number,
	nconst:: string,
	category:: string,
	job:: string,
	characters:: string[]
}

#@ persist name="principals"
source: principals_base is raw_principals -> {
	join_one: titles is titles_base on tconst = titles.tconst
	where: titles.tconst is not null
	select: 
		tconst
		ordering is ordering::number
		nconst
		category
		job
		characters is str_split!string[](
	regexp_replace!(characters,'[\[\]\"]','','g'),
	',')
}::principal_type extend {
	view: test is {
		select: *
		limit: 10
	}
}

type: year_ratings is {
  startYear:: number,
  year_ratings_acting:: number,
  year_ratings_directing:: number,
  year_rank:: number
}

type: person_type is {
  nconst:: string,
  birthYear:: number,
  deathYear:: number,
  primaryName:: string,
  primaryProfession:: string,
  lifetime_rank_acting:: number,
  lifetime_ratings_acting:: number,
  lifetime_rank_directing:: number,
  lifetime_ratings_directing:: number,
  by_year:: year_ratings[]
}

#@ persist name="names"
source: people_base is   raw_names -> {
	join_many: principals is principals_base on nconst = principals.nconst
	join_one: titles is titles_base on principals.tconst = titles.tconst
	where: principals.nconst is not null
	group_by:
		nconst
		primaryName
		primaryProfession
		birthYear is birthYear:::number
		deathYear is deathYear:::number
		titles.startYear
	aggregate:
		year_ratings_acting is titles.numVotes.sum() {where: principals.category = 'actor' | 'actress' }
		year_ratings_directing is titles.numVotes.sum() {where: principals.category = 'director' }
	calculate:
		year_rank is rank() {partition_by: startYear order_by: year_ratings_acting desc}
	}
	-> {
		group_by:
			nconst
			primaryName
			primaryProfession
			birthYear is birthYear:::number
			deathYear is deathYear:::number
		aggregate:
		  lifetime_ratings_acting is year_ratings_acting.sum()
		  lifetime_ratings_directing is year_ratings_directing.sum()
		calculate:
		  lifetime_rank_acting is rank() {order_by: lifetime_ratings_acting desc}
		  lifetime_rank_directing is rank() {order_by: lifetime_ratings_directing desc}
		nest: by_year is {
			group_by:
				startYear
				year_ratings_acting
				year_ratings_directing
				year_rank
		}
		order_by: nconst
	}::person_type

