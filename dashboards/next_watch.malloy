##! experimental.virtual_source experimental.persistence experimental.join_types experimental.givens experimental.access_modifiers
import "../index.malloy"

// Queries for the recommender. The scoring rationale lives in next_watch.malloy.

#" What the liked titles have in common, strongest signal first
query: taste_profile is taste_features -> {
  where: tconst ~ $LIKED
  group_by: kind, feature
  aggregate: weight is feature_weight
  order_by: weight desc
  limit: 60
}

#" Recommendations for the current liked set
# artifact { title="Your next watch" }
query: recommendations is scoring -> {
  // Exclusion of the already-rated happens in the UI, not here: `not (x ~ $G)`
  // silently returned zero rows for every input, and a filter that quietly
  // matches nothing is worse than one that is absent.
  where:
    liked_side.tconst ~ $LIKED
    and title.numVotes ~ $MIN_VOTES
  group_by:
    tconst
    primary_title is title.primaryTitle
    title_type is title.titleType
    start_year is title.startYear
    average_rating is title.averageRating
    num_votes is title.numVotes
    director is title.directors
    // was missing entirely: the list rendered grey placeholders under a wall of
    // real posters and read as broken rather than as a different section
    poster is pick null when poster.poster_path is null
      else concat('https://image.tmdb.org/t/p/w154', poster.poster_path)
  aggregate:
    fit
    genre_fit
    crew_fit
    cast_fit
    shared_crew
    shared_cast
    shared_genres
    // candidate vector length, for cosine normalisation in the UI
    norm is title_norm.max()
  order_by: fit desc
  limit: 400
}

// --- the cold start ---------------------------------------------------------
// Seed titles for the poster grid and the swipe deck. Widely-known enough that
// a visitor has an opinion, spread across genres so each tap discriminates
// instead of confirming what everything already shares (CHARTER §4.1).
#" Well-known titles to rate, spread across genres
query: seed_titles is movies -> {
  where: numVotes > 150000
  group_by:
    tconst
    primary_title is primaryTitle
    title_type is titleType
    start_year is startYear
    average_rating is averageRating
    num_votes is numVotes
    poster is movie_image
    genre is genres.value
  order_by: num_votes desc
  limit: 400
}

// --- search (F6) ------------------------------------------------------------
#" Find a specific title to rate
query: search_titles is movies -> {
  // lowercased both sides: `batman` returned 0 while `Batman` returned 27,
  // and the failure was silent -- no result, no empty state, no hint why
  where: lower(primaryTitle) ~ $TITLE
  group_by:
    tconst
    primary_title is primaryTitle
    title_type is titleType
    start_year is startYear
    average_rating is averageRating
    num_votes is numVotes
    poster is movie_image
  order_by: num_votes desc
  limit: 40
}

// --- availability (F1) ------------------------------------------------------
#" One row per title: the streaming services it is on, for the poster mark.
// Returning every offer row meant 220,963 rows, which the runtime truncates --
// so most posters silently lost their badge. Collapsing to one row per title
// makes coverage complete AND the payload an order of magnitude smaller.
query: availability is providers -> {
  where: offer_kind = 'flatrate'
  group_by: imdb_id
  aggregate:
    logos is string_agg(logo_path, '|')
    names is string_agg(provider_name, ', ')
    attribution is max(attribution)
    votes is title.numVotes.max()
  // ⛔ THE RUNTIME CAPS A RESULT AT 5,000 ROWS, whatever `limit` says --
  // measured, not assumed. 15,343 titles have streaming, so a third get
  // through and WHICH third was arbitrary: the browser was handed obscure
  // titles while 42 of the 48 most-voted posters on screen lost a badge they
  // had every right to. Ordering by popularity makes the 5,000 that survive
  // the ones actually being looked at. A truncated result that still renders
  // is the worst kind of bug -- nothing fails, it is just quietly wrong.
  order_by: votes desc
  limit: 5000
}

#" Every viewing option for ONE title, for the detail view
query: availability_detail is providers -> {
  where: imdb_id ~ $DETAIL_ID
  group_by: imdb_id, offer_kind, provider_name, logo_path, link, attribution
  order_by: provider_name
}

// --- people search (F6 / F4) -------------------------------------------------
// Naming one actor or director is far cheaper for a visitor than naming ten
// films, so a person is a legitimate way in. Picking one does NOT mark their
// filmography as liked -- that would recommend someone the worst film of a
// favourite actor's career and call it a match. It surfaces their titles to
// rate, which is the honest version of "seed from a person" (CHARTER F4).
#" Find a person
query: search_people is movies -> {
  where: lower(name) ~ $NAME
  group_by: person is name
  aggregate:
    titles is title_count
    total_ratings
  order_by: total_ratings desc
  limit: 24
}

#" Titles featuring the named person, to rate
query: titles_by_person is movies -> {
  where: name ~ $PERSON_EXACT
  group_by:
    tconst
    primary_title is primaryTitle
    title_type is titleType
    start_year is startYear
    average_rating is averageRating
    num_votes is numVotes
    poster is movie_image
  order_by: num_votes desc
  limit: 40
}
