##! experimental.virtual_source experimental.persistence experimental.join_types experimental.givens experimental.access_modifiers
import "../index.malloy"

// Two genres and (optionally) one year. GENRE / GENRE2 are the two halves of the
// combination; the model's `genre` and `genre2` dimensions are independent joins
// onto the same title, so filtering both finds films carrying BOTH labels.
//
// YEAR is a filter<number> whose EMPTY value means "All Time" — there is no
// separate all-time flag, an empty filter simply matches every row. The stepper
// in genre_pairs.jsx moves it one year at a time.
given:
  # label="Second Genre" suggest{source=movies dimension=genre}
  GENRE2 :: filter<string> is f'Romance'

  # label="Year"
  RELEASE_YEAR :: filter<number> is f''

// Headline numbers for the chosen genre, across all years or just one.
# artifact { title="Genre Combinations" givens { GENRE="Comedy" RELEASE_YEAR="" } }
# dashboard
#" Pick a genre and see its strongest pairings, shelf by shelf
query: genre_pairs is movies -> {
  where: genre ~ $GENRE and release_year ~ $RELEASE_YEAR
  aggregate:
    title_count
    total_ratings
    # label="Average Rating"
    average_rating
}

// Every genre with how many films carry it — feeds the genre picker. Genres
// under 100 films are dropped: they make for a long picker and one-tile shelves.
query: genre_options is movies -> {
  group_by: genre is genres.value
  aggregate: title_count
  having: title_count >= 100
  order_by: title_count desc
}

// One shelf per subgenre: every other genre GENRE pairs with, each nesting its
// seven most-voted films. Grouping the nest by tconst collapses the
// principal/genre join fan-out, and total_votes uses max() rather than sum() so
// it stays the title's own vote count. Shelves are ordered by total_ratings, a
// symmetric aggregate that survives the fan-out.
query: genre_shelves is movies -> {
  where: genre ~ $GENRE and genre != genre2 and release_year ~ $RELEASE_YEAR
  group_by: subgenre is genre2
  aggregate:
    title_count
    total_ratings
  nest: titles is {
    group_by:
      tconst
      title
      release_year
      movie_image
      movie_url
    aggregate:
      # label="Votes"
      total_votes is numVotes.max()
      average_rating
    order_by: total_votes desc
    // Six rows' worth. The shelf shows seven at a time and reveals the rest on
    // demand, so this is the ceiling on "Show more", not what renders up front.
    limit: 42
  }
  order_by: total_ratings desc
  limit: 24
}

// The timeline: the chosen genre's films bucketed into 5-year periods, which the
// bar picker renders and clicks through to a RELEASE_YEAR range. `period` is the
// first year of the bucket, so 1994 lands in 1990 and the label reads 1990–94.
//
// Ignores RELEASE_YEAR on purpose — the whole timeline has to stay visible while
// one period is selected, otherwise selecting a bar would erase every other bar.
query: genre_periods is movies -> {
  where: genre ~ $GENRE
  group_by: period is floor(release_year / 5) * 5
  aggregate:
    title_count
    total_ratings
  order_by: period
}

// FORK ADDITION (F1): US availability for the titles on this page, so each
// poster can carry its provider mark. Every row carries JustWatch's
// attribution because TMDB requires the credit on each media item.
//
// ⛔ ONE ROW PER TITLE, ORDERED BY POPULARITY, AND THAT IS LOad-BEARING.
// This query used to return one row per (title x offer_kind x provider) with no
// filter, no collapse and no order: 220,963 rows against a runtime that CAPS a
// result at 5,000 whatever you ask for. So ~2% got through, WHICH 2% was
// arbitrary, and this page — the one a visitor lands on — rendered 167 posters
// carrying THREE marks. Nothing errored; the feature was simply, quietly
// missing. next_watch's copy of this query was fixed for exactly this months
// ago and this one was never given the same treatment.
// Collapsing to one row per title cut it to 15,343 rows — an order of magnitude
// smaller, and ordering by votes meant the 5,000 that survived were at least the
// most-watched ones. But 15,343 > 5,000, so 10,343 titles STILL could not be
// marked and coverage fell to 36% on a small genre like Western: El Dorado
// (1966), on MGM Plus and YouTube TV, showed nothing.
//
// ⛔ AND `limit` DOES NOT LIFT THE CAP — measured, not assumed. Raising it to
// 20,000 changed the rendered page not at all: still 37% on Western, El Dorado
// still bare. The cap is the runtime's, and asking louder does not move it.
//
// So the result is SPLIT INTO FOUR VOTE BANDS at the quartiles of the streamable
// set, each ~3,836 rows and comfortably under the cap, merged in the UI. Four
// queries of a third the size beat one that silently drops two thirds of its
// answer. The bands are vote quartiles because votes are already the axis the
// page orders by, so a band maps to a coherent slice rather than an arbitrary one.
#" Where to watch — most-watched band
query: availability is providers -> {
  where: offer_kind = 'flatrate' and title.numVotes >= 50400
  group_by: imdb_id
  aggregate:
    logos is string_agg(logo_path, '|')
    names is string_agg(provider_name, ', ')
  limit: 5000
}
#" Where to watch — upper-middle band
query: availability_b is providers -> {
  where: offer_kind = 'flatrate' and title.numVotes >= 16866 and title.numVotes < 50400
  group_by: imdb_id
  aggregate:
    logos is string_agg(logo_path, '|')
    names is string_agg(provider_name, ', ')
  limit: 5000
}
#" Where to watch — lower-middle band
query: availability_c is providers -> {
  where: offer_kind = 'flatrate' and title.numVotes >= 8414 and title.numVotes < 16866
  group_by: imdb_id
  aggregate:
    logos is string_agg(logo_path, '|')
    names is string_agg(provider_name, ', ')
  limit: 5000
}
#" Where to watch — long tail
query: availability_d is providers -> {
  where: offer_kind = 'flatrate' and title.numVotes < 8414
  group_by: imdb_id
  aggregate:
    logos is string_agg(logo_path, '|')
    names is string_agg(provider_name, ', ')
  limit: 5000
}
