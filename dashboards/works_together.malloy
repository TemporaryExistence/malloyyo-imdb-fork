##! experimental.virtual_source experimental.persistence experimental.join_types experimental.givens experimental.access_modifiers
import "../index.malloy"

# artifact { title="People that worked together" givens {NAME='Tom Hanks'}}
query: works_together is movies -> works_with + {
  where: name ~ $NAME
  nest: by_title is {
    group_by: title
    aggregate: total_ratings
  }
}

// FORK ADDITION (F1/F4): same availability feed, so titles listed against a
// person also show where they can be watched.
#" Where to watch
query: availability is providers -> {
  group_by: imdb_id, offer_kind, provider_name, logo_path, link, attribution
}
